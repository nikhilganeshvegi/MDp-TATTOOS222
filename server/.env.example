# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String (process.env.MONGODB_URI)
# Replace with your actual MongoDB URI in your local .env file
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tattoo_booking?retryWrites=true&w=majority

# Admin Authentication
ADMIN_EMAIL=mdptattoos10@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_JWT_SECRET=your_jwt_signing_secret_here
